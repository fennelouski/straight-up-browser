    "Open Browser and turn your tabs into a workspace first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Browser وحوّل علامات التبويب إلى مساحة عمل أولًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer obre Browser i converteix les teves pestanyes en un espai de treball."
          }
