<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.assets.pictures.read-write</key>
	<true/>
	<!-- Hardened Runtime (required for notarization) blocks camera/mic even with
	     App Sandbox on. Without these, getUserMedia fails and sites report no
	     devices found, regardless of the WKUIDelegate permission handler. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Sparkle auto-update from inside the App Sandbox. Checking the appcast only
	     needs network.client, so without these the app finds an update, says so,
	     and then silently fails to install it — the sandbox blocks the lookup of
	     Sparkle's installer XPC services. -spks is the installer launcher, -spki
	     the installer connection/status service; both are required.
	     Paired with SUEnableInstallerLauncherService in Browser-Info.plist. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.nathanfennel.Straight-Up-Browser</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
